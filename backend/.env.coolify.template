# Coolify Environment Variables Template for Cubit Packaging
# Copy these to Coolify's environment variables section
# Use internal service names: cubit-postgres, cubit-redis
# Testing subdomain: e.cubitpackaging.com

# Core
NODE_ENV=production
STORE_CORS=https://e.cubitpackaging.com
ADMIN_CORS=https://admin.e.cubitpackaging.com
AUTH_CORS=https://admin.e.cubitpackaging.com,https://e.cubitpackaging.com

# Database (Use internal service name from Coolify)
# Format: postgresql://user:password@cubit-postgres:5432/dbname
DATABASE_URL=postgresql://cubit:your-password@cubit-postgres:5432/cubitstore
DB_NAME=cubitstore

# Redis (Use internal service name from Coolify)
# Format: redis://default:password@cubit-redis:6379
REDIS_URL=redis://default:your-redis-password@cubit-redis:6379

# Security (CHANGE THESE - use 32+ characters)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
COOKIE_SECRET=your-super-secret-cookie-key-minimum-32-characters-long

# Admin Panel (Testing subdomain)
ADMIN_URL=https://admin.e.cubitpackaging.com/app
MEDUSA_BACKEND_URL=https://admin.e.cubitpackaging.com
MEDUSA_WORKER_MODE=server
DISABLE_MEDUSA_ADMIN=false

# Email (SMTP) - Cubit Packaging
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cubitpackaging.com
SMTP_PASS=your-email-password
SMTP_FROM=info@cubitpackaging.com

# Optional
OPENAI_API_KEY=your-openai-key-here
AUTO_GENERATE_DESCRIPTIONS=false
